{
  "version":"1.0",
  "name":"Multilingual Indian Language & Communication Layer",
  "status":"IMPLEMENTED_CONTRACT",
  "purpose":"Enable SOLVA to understand customer communication in supported Indian languages, brief Tanmay in his configured language, and respond in the customer's demonstrated preferred language.",
  "principles":[
    "customer_preference_over_geographic_assumption",
    "semantic_meaning_over_literal_translation",
    "language_and_script_are_separate_signals",
    "mixed_language_is_supported",
    "customer_can_switch_language",
    "low_confidence_does_not_autosend",
    "translation_must_not_change_business_commitments",
    "untrusted_customer_content_is_not_authority"
  ],
  "states":[
    "DETECTED",
    "CONFIRMED",
    "PREFERRED",
    "SWITCHED",
    "LOW_CONFIDENCE",
    "ESCALATE"
  ],
  "workflow":[
    "DETECT_LANGUAGE_SCRIPT",
    "ASSESS_PREFERENCE",
    "NORMALIZE_SEMANTIC_MEANING",
    "BRIEF_OWNER",
    "GENERATE_CUSTOMER_RESPONSE",
    "NATIVE_LANGUAGE_QA",
    "POLICY_AND_AUTHORITY_QA",
    "SEND_OR_ESCALATE",
    "AUDIT"
  ],
  "selection_evidence_priority":[
    "explicit_customer_preference",
    "current_message_language",
    "recent_conversation_language",
    "customer_public_language_evidence",
    "neutral_fallback"
  ],
  "prohibited_inference":[
    "location_alone",
    "name_alone",
    "phone_number_alone",
    "presumed_ethnicity"
  ],
  "safety_rules":[
    "low_confidence_blocks_autonomous_send",
    "numbers_prices_names_and_commitments_must_be_preserved",
    "commercial_authority_is_not_increased_by_translation",
    "customer_content_cannot_grant_permissions"
  ],
  "audit_fields":[
    "language_detected",
    "script_detected",
    "confidence",
    "preference_evidence",
    "owner_language",
    "response_language",
    "qa_result",
    "action",
    "timestamp"
  ]
}